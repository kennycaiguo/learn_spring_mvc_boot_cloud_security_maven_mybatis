<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.kenny.mybatis.mapper.ClazzMapper">
    <!--方式1，collection-->
    <resultMap id="clazzResultMap" type="Clazz">
        <id column="cid" property="cid" />
        <result column="cname" property="cname" />
        <collection property="students" ofType="Student">
            <id column="sid" property="sid" />
            <result column="sname" property="sname" />
        </collection>
    </resultMap>

    <select id="selectClazzAndStusByCid" resultMap="clazzResultMap">
        select c.cid,c.cname,s.sid,s.sname from t_clazz c join t_student s on c.cid=s.cid where c.cid=#{cid}
    </select>
    <resultMap id="clazzResultMapLazy" type="Clazz">
        <id column="cid" property="cid" />
        <result column="cname" property="cname" />
        <collection property="students" select="org.kenny.mybatis.mapper.StudentMapper.selectByCid" column="cid"/>
    </resultMap>
    <!--方式2.分步查询-->
    <select id="selectClazzAndStusByCidStep" resultMap="clazzResultMapLazy">
         select cid,cname from t_clazz where cid=#{cid}
    </select>

    <select id="selectClazzByCid" resultType="Clazz">
        select cid,cname from t_clazz where cid=#{cid}
    </select>


</mapper>