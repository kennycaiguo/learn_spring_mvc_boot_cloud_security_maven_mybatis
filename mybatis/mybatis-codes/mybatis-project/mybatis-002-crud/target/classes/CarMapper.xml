<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="Car">
  <!-- 使用map类型作为参数 -->
   <insert id="insertCar" parameterType="java.util.Map" >
     <!--mybatis中是占位符是#{},如果你在java代码里面是使用map来赋值，#{}里面需要写map的key-->
       insert into t_car
            (id,car_num,brand,guide_price,produce_time,car_type)
       values
            (null,#{car_num},#{brand},#{guide_price},#{produce_time},#{car_type})
   </insert>
  <!--使用实体类作为参数-->
    <insert id="insertCar2" parameterType="org.kenny.mybatis.entity.Car" >
        <!--mybatis中是占位符是#{},如果你在java代码里面是使用map来赋值，#{}里面需要写map的key-->
        insert into t_car
        (id,car_num,brand,guide_price,produce_time,car_type)
        values
        (null,#{carNum},#{brand},#{guidePrice},#{produceTime},#{carType})
    </insert>
    <delete id="deleteById">
        delete from t_car where id=#{id}
    </delete>
    <update id="updateById">
        update t_car set car_num=#{carNum},brand=#{brand},guide_price=#{guidePrice},
               produce_time=#{produceTime},car_type=#{carType} where id=#{id}
    </update>
    <update id="updateById2">
        update t_car set brand=#{brand},guide_price=#{guidePrice}, car_type=#{carType} where id=#{id}
    </update>
    <!--select语句有坑，需要指定resultType，否则报错-->
    <select id="selectById" parameterType="long" resultType="org.kenny.mybatis.entity.Car">
        select id,car_num as carNum,brand,guide_price as guidePrice, produce_time as produceTime,car_type as carType
        from t_car where id=#{id}
    </select>
   <!--查询多个，这个可以给selectList方法使用 -->
    <select id="selectByCarNum" parameterType="string" resultType="org.kenny.mybatis.entity.Car">
        select id,car_num as carNum,brand,guide_price as guidePrice, produce_time as produceTime,car_type as carType
        from t_car where car_num=#{num}
    </select>
   <!--查询所有,返回值类型是org.kenny.mybatis.entity.Car而不是List，这个需要注意-->
    <select id="selectAll" resultType="org.kenny.mybatis.entity.Car">
        select  id,car_num as carNum,brand,guide_price as guidePrice, produce_time as produceTime,car_type as carType
        from t_car
    </select>
</mapper>