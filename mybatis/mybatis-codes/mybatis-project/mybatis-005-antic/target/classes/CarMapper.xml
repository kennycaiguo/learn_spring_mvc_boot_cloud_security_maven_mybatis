<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--namespace先随意写一个-->
<mapper namespace="org.kenny.mybatis.mapper.CarMapper">
    <!--insert sql：保存一个汽车信息-->
    <!--
       可用标签，insert,update,delete,select
       在mapper文件中，sql语句可用不用;结尾
    -->
    <insert id="insertCar" parameterType="org.kenny.mybatis.entity.Car">
        insert into t_car
            (id,car_num,brand,guide_price,produce_time,car_type)
        values
            (null,#{carNum},#{brand},#{guidePrice},#{produceTime},#{carType})
    </insert>
    <select id="selectAllByTableName" parameterType="string" resultType="org.kenny.mybatis.entity.Car">
        select
            id,car_num as carNum,brand,guide_price as guidePrice,produce_time as produceTime,car_type as carType
        from
            ${tableName}
    </select>
    <select id="selectByCarNum">
        select
            id,car_num as carNum,brand,guide_price as guidePrice,produce_time as produceTime,car_type as carType
        from
            t_car
        where
            car_num=#{carNum}
    </select>
    <select id="selectById">
        select
            id,car_num as carNum,brand,guide_price as guidePrice,produce_time as produceTime,car_type as carType
        from
            t_car
        where
            id=#{id}
    </select>
    <update id="updateById">
        update
            t_car
        set
            car_num=#{carNum},brand=#{brand},guide_price=#{guidePrice},produce_time=#{produceTime},car_type=#{carType}
        where
            id=#{id}
    </update>
    <delete id="deleteById">
        delete from t_car where id=#{id}
    </delete>
</mapper>