<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="userBean" class="org.kenny.spring.entity.User">
        <property name="name" value="Jack" />
        <property name="age" value="20" />
    </bean>

    <!--关联模拟连接池-->
    <bean id="myPoolBean" class="org.kenny.spring.pool.MyPool">
        <property name="driverClassName" value="com.mysql.cj.jdbc.Driver" />
        <property name="url" value="jdbc:mysql://localhost:3306/spring" />
        <property name="username" value="root" />
        <property name="password" value="root" />
        <property name="initialSize" value="10" />
        <property name="maxActive" value="20" />
     </bean>

    <!--级联-->
    <bean id="clazzBean" class="org.kenny.spring.entity.Clazz" />
    <bean id="studentBean" class="org.kenny.spring.entity.Student">
        <property name="name" value="Jack" />
        <!--Clazz不是简单类型，需要使用ref-->
        <property name="clazz" ref="clazzBean" />
        <!--给引用属性的简单类型属性赋值,这个属性需要通过getter-->
        <property name="clazz.name" value="高三(1)班" />
    </bean>
     <!--注入数组-->
     <bean id="personBean" class="org.kenny.spring.entity.Person">
         <property name="name" value="Mary" />
         <property name="favoriteFoods" >
             <array>
                 <value>鸡排</value>
                 <value>汉堡</value>
                 <value>鹅肝</value>
             </array>
         </property>
     </bean>
    <!--注入对象数组-->
    <bean id="goodsBean" class="org.kenny.spring.entity.Goods">
        <property name="name" value="IPhone13"/>
    </bean>
    <bean id="goodsBean2" class="org.kenny.spring.entity.Goods">
        <property name="name" value="MacBook Pro"/>
    </bean>
    <bean id="orderBean" class="org.kenny.spring.entity.Order">
        <property name="orderId" value="123" />
        <property name="clientName" value="Dragon Wholesale" />
        <property name="goods">
            <array>
                <!--此时需要使用外部bean-->
                <ref bean="goodsBean"/>
                <ref bean="goodsBean2"/>
            </array>
        </property>
    </bean>

    <!--注入List和Map-->
    <bean id="peopleBean" class="org.kenny.spring.entity.People">
        <property name="name" value="李明" />
        <property name="nicknames" >
            <list>
                <value>小明</value>
                <value>明仔</value>
                <value>二哥</value>
                <value>二狗</value>
            </list>
        </property>
        <property name="emails" >
            <map>
                <!--如果key不是简单类型，使用 key-ref 属性-->
                <!--如果value不是简单类型，使用 value-ref 属性-->
                <entry key="1" value="Jack1234@gmail.com"/>
                <entry key="2" value="Jackgood333@hotmail.com"/>
                <entry key="3" value="Jackfood$$@qq.com"/>
            </map>
        </property>
    </bean>
     <!--注入set,set有去重功能，你新建多个相同的value，只会设置一个到对象里面-->
     <bean id="contactBean" class="org.kenny.spring.entity.Contact">
         <property name="phones" >
             <set>
                 <value>13566677770</value>
                 <value>13566677770</value>
                 <value>13566677770</value>
                 <value>13666677880</value>
                 <value>13966622889</value>
             </set>
         </property>
     </bean>

     <!--注入Properties对象，本质上是一个但是配置方法不一样-->
    <bean id="myConfBean" class="org.kenny.spring.entity.MyConf">
        <property name="properties">
           <props>
               <prop key="driver">com.mysql.cj.jdbc.Driver</prop>
               <prop key="url">jdbc:mysql://localhost:3306/spring</prop>
               <prop key="user">com.mysql.cj.jdbc.Driver</prop>
               <prop key="password">root</prop>
               <prop key="initialSize">root</prop>
               <prop key="maxActive">10</prop>
               <prop key="driver">20</prop>
           </props>
        </property>
    </bean>
    <!--注入空值和null-->
    <bean id="fakeUserBean" class="org.kenny.spring.entity.FakeUser" >
        <!--写法1-->
        <!--<property name="name" value="" />-->
        <!--<property name="email" value="null" />-->
       <!--写法2 -->
        <property name="name">
        <!--用一个空value标签就是空-->
            <value />
        </property>
       <!--email不给它配置，就是null-->
    </bean>

    <!--注入有特殊字符的值-->
    <bean id="mathBean" class="org.kenny.spring.entity.MyMath">
       <!--2<3的写法-->
        <property name="result" value="2 &lt; 3" />
    </bean>


</beans>